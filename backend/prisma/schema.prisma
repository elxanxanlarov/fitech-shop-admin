generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// === ENUMS ===

enum deletetype {
  NONE
  SOFT
  HARD
  ARCHIVED
}

enum unittype {
  PIECE
  BOX
  LITER
  METER
  KILOGRAM
}

enum activityaction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  HARD_DELETE
  LOGIN
  LOGOUT
  SALE
  RETURN
}

enum stockmovementtype {
  IN
  OUT
  ADJUSTMENT
}

enum transferstatus {
  PENDING
  COMPLETED
  CANCELLED
  SHIPPED
}

// === MODELS ===

model role {
  id         String     @id @default(uuid())
  name       String     @unique(map: "Role_name_key")
  isCore     Boolean    @default(false)
  deleteType deletetype @default(NONE)
  staff      staff[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("role")
}

model category {
  id            String        @id @default(uuid())
  name          String
  description   String?
  isActive      Boolean       @default(true)
  deleteType    deletetype    @default(NONE)
  branchId      String?
  branch        branch?       @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  subCategories subcategory[]
  products      product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("category")
}

model subcategory {
  id          String     @id @default(uuid())
  name        String
  description String?
  categoryId  String
  category    category   @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  isActive    Boolean    @default(true)
  branchId    String?
  branch      branch?    @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  deleteType  deletetype @default(NONE)
  products    product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, categoryId], map: "SubCategory_name_categoryId_key")
  @@map("subcategory")
}

model product {
  id                String              @id @default(uuid())
  name              String
  invoiceName       String?
  description       String?
  imageUrl          String?
  purchasePrice     Decimal             @db.Decimal(10, 2)
  salePrice         Decimal             @db.Decimal(10, 2)
  hasDiscount       Boolean             @default(false)
  discountPrice     Decimal?            @db.Decimal(10, 2)
  discountPercent   Int?
  unitType          unittype            @default(PIECE)
  piecesPerBox      Int?
  openedBoxQuantity Int                 @default(0)
  boxPrice          Decimal?            @db.Decimal(10, 2)
  barcode           String?             @unique(map: "Product_barcode_key")
  stock             Int                 @default(0)
  fullBoxes         Int                 @default(0)
  isActive          Boolean             @default(true)
  isOfficial        Boolean             @default(false)
  deleteType        deletetype          @default(NONE)
  categoryId        String?
  category          category?           @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  subCategoryId     String?
  subCategory       subcategory?        @relation(fields: [subCategoryId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  saleItems         saleitem[]
  returnItems       salereturnitem[]
  stockMovements    stockmovement[]
  finalDeliveryItems finaldeliveryitem[]
  branchStocks      branchstock[]
  transferItems     stocktransferitem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("product")
}

model sale {
  id                    String          @id @default(uuid())
  customerName          String?
  customerSurname       String?
  customerPhone         String?
  totalAmount           Decimal         @db.Decimal(10, 2)
  paidAmount            Decimal         @db.Decimal(10, 2)
  profitAmount          Decimal?        @db.Decimal(10, 2)
  paymentType           String?
  isCredit              Boolean         @default(false)
  creditTermId          String?
  creditTerm            creditterm?     @relation(fields: [creditTermId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  creditInterestPercent Decimal?        @db.Decimal(5, 2)
  creditTotalAmount     Decimal?        @db.Decimal(10, 2)
  creditRemainingAmount Decimal?        @db.Decimal(10, 2)
  creditMonthlyPayment  Decimal?        @db.Decimal(10, 2)
  creditStartDate       DateTime?
  creditEndDate         DateTime?
  isCreditPaid          Boolean         @default(false)
  isRefunded            Boolean         @default(false)
  refundedAt            DateTime?
  note                  String?
  deleteType            deletetype      @default(NONE)
  branchId              String?
  branch                branch?         @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  items                 saleitem[]
  returns               salereturn[]
  receipts              receipt[]
  creditPayments        creditpayment[]
  notifications         notification[]

  @@map("sale")
}

model saleitem {
  id            String           @id @default(uuid())
  saleId        String
  sale          sale             @relation(fields: [saleId], references: [id], onUpdate: Cascade)
  productId     String
  product       product          @relation(fields: [productId], references: [id], onUpdate: Cascade)
  quantity      Int
  pricePerItem  Decimal          @db.Decimal(10, 2)
  totalPrice    Decimal          @db.Decimal(10, 2)
  purchasePrice Decimal          @db.Decimal(10, 2)
  profit        Decimal          @db.Decimal(10, 2)
  returnItems   salereturnitem[]

  @@map("saleitem")
}

model salereturn {
  id              String           @id @default(uuid())
  saleId          String
  sale            sale             @relation(fields: [saleId], references: [id], onUpdate: Cascade)
  customerName    String?
  customerSurname String?
  customerPhone   String?
  totalAmount     Decimal          @db.Decimal(10, 2)
  returnedAmount  Decimal          @db.Decimal(10, 2)
  reason          String?
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branchId        String?
  branch          branch?          @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  items           salereturnitem[]

  @@map("salereturn")
}

model salereturnitem {
  id            String     @id @default(uuid())
  returnId      String
  return        salereturn @relation(fields: [returnId], references: [id], onUpdate: Cascade)
  saleItemId    String
  saleItem      saleitem   @relation(fields: [saleItemId], references: [id], onUpdate: Cascade)
  productId     String
  product       product    @relation(fields: [productId], references: [id], onUpdate: Cascade)
  quantity      Int
  pricePerItem  Decimal    @db.Decimal(10, 2)
  totalPrice    Decimal    @db.Decimal(10, 2)
  purchasePrice Decimal    @db.Decimal(10, 2)
  loss          Decimal    @db.Decimal(10, 2)

  @@map("salereturnitem")
}

model activitylog {
  id          String         @id @default(uuid())
  staffId     String?
  staff       staff?         @relation(fields: [staffId], references: [id], onUpdate: Cascade)
  branchId    String?
  branch      branch?        @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  entityType  String
  entityId    String
  action      activityaction
  description String?
  changes     Json?
  createdAt   DateTime       @default(now())

  @@map("activitylog")
}

model receipt {
  id              String   @id @default(uuid())
  saleId          String   @unique(map: "Receipt_saleId_key")
  sale            sale     @relation(fields: [saleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  receiptNumber   String   @unique(map: "Receipt_receiptNumber_key")
  customerName    String?
  customerSurname String?
  customerPhone   String?
  totalAmount     Decimal  @db.Decimal(10, 2)
  paidAmount      Decimal  @db.Decimal(10, 2)
  profitAmount    Decimal? @db.Decimal(10, 2)
  paymentType     String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("receipt")
}

model expense {
  id          String     @id @default(uuid())
  title       String
  description String?
  amount      Decimal    @db.Decimal(10, 2)
  category    String?
  date        DateTime   @default(now())
  note        String?
  staffId     String?
  staff       staff?     @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  branchId    String?
  branch      branch?    @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  deleteType  deletetype @default(NONE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("expense")
}

model cashhandover {
  id             String     @id @default(uuid())
  date           DateTime   @default(now())
  amount         Decimal    @db.Decimal(10, 2)
  note           String?
  handedOverToId String
  handedOverTo   staff      @relation("handedoverto", fields: [handedOverToId], references: [id], onUpdate: Cascade)
  handedOverById String
  handedOverBy   staff      @relation("handedoverby", fields: [handedOverById], references: [id], onUpdate: Cascade)
  branchId       String?
  branch         branch?    @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  deleteType     deletetype @default(NONE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("cashhandover")
}

model stockmovement {
  id                        String            @id @default(uuid())
  productId                 String
  product                   product           @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  type                      stockmovementtype
  quantity                  Int
  previousStock             Int
  newStock                  Int
  previousFullBoxes         Int?
  newFullBoxes              Int?
  previousOpenedBoxQuantity Int?
  newOpenedBoxQuantity      Int?
  note                      String?
  staffId                   String?
  staff                     staff?            @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  branchId                  String?
  branch                    branch?           @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@map("stockmovement")
}

model creditterm {
  id           String   @id @default(uuid())
  months       Int      @unique(map: "CreditTerm_months_key")
  interestRate Decimal  @db.Decimal(5, 2)
  description  String?
  isActive     Boolean  @default(true)
  sales        sale[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("creditterm")
}

model creditpayment {
  id          String   @id @default(uuid())
  saleId      String
  sale        sale     @relation(fields: [saleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  amount      Decimal  @db.Decimal(10, 2)
  paymentDate DateTime @default(now())
  paymentType String?
  note        String?
  staffId     String?
  staff       staff?   @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  branchId    String?
  branch      branch?  @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("creditpayment")
}

model notification {
  id        String    @id @default(uuid())
  type      String
  title     String
  message   String
  saleId    String?
  sale      sale?     @relation(fields: [saleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  isRead    Boolean   @default(false)
  readAt    DateTime?
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("notification")
}

model staff {
  id                    String          @id @default(uuid())
  name                  String
  surName               String?
  phone                 String?
  email                 String          @unique(map: "Staff_email_key")
  password              String?
  isActive              Boolean         @default(true)
  roleId                String?
  role                  role?           @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  isBoss                Boolean         @default(false)
  branchId              String?
  branch                branch?         @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  activities            activitylog[]
  expenses              expense[]
  cashHandoversReceived cashhandover[]  @relation("handedoverto")
  cashHandoversGiven    cashhandover[]  @relation("handedoverby")
  stockMovements        stockmovement[]
  creditPayments        creditpayment[]
  finalDeliveries       finaldelivery[]
  dailySummaries        dailysummary[]
  transfers             stocktransfer[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("staff")
}

model finaldelivery {
  id         String              @id @default(uuid())
  title      String
  startDate  DateTime
  endDate    DateTime
  note       String?
  staffId    String?
  staff      staff?              @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  branchId   String?
  branch     branch?             @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  items      finaldeliveryitem[]
  deleteType deletetype          @default(NONE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("finaldelivery")
}

model finaldeliveryitem {
  id                String        @id @default(uuid())
  finalDeliveryId   String
  finalDelivery     finaldelivery @relation(fields: [finalDeliveryId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  productId         String
  product           product       @relation(fields: [productId], references: [id], onUpdate: Cascade)
  remainingStock    Int
  stock             Int
  fullBoxes         Int           @default(0)
  openedBoxQuantity Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("finaldeliveryitem")
}

model dailysummary {
  id              String     @id @default(uuid())
  date            DateTime
  totalSalesCount Int
  totalProducts   Int
  totalQuantity   Int
  totalRevenue    Decimal    @db.Decimal(10, 2)
  totalPurchase   Decimal    @db.Decimal(10, 2)
  totalProfit     Decimal    @db.Decimal(10, 2)
  note            String?
  staffId         String?
  staff           staff?     @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  branchId        String?
  branch          branch?    @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  deleteType      deletetype @default(NONE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("dailysummary")
}

model branch {
  id              String          @id @default(uuid())
  name            String          @unique(map: "Branch_name_key")
  address         String?
  phone           String?
  isActive        Boolean         @default(true)
  deleteType      deletetype      @default(NONE)
  stocks          branchstock[]
  transfersFrom   stocktransfer[] @relation("transferfrom")
  transfersTo     stocktransfer[] @relation("transferto")
  staff           staff[]
  sales           sale[]
  stockMovements  stockmovement[]
  expenses        expense[]
  cashHandovers   cashhandover[]
  finalDeliveries finaldelivery[]
  dailySummaries  dailysummary[]
  creditPayments  creditpayment[]
  saleReturns     salereturn[]
  categories      category[]
  subCategories   subcategory[]
  activityLogs    activitylog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("branch")
}

model branchstock {
  id                String   @id @default(uuid())
  branchId          String
  branch            branch   @relation(fields: [branchId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  productId         String
  product           product  @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  stock             Int      @default(0)
  fullBoxes         Int      @default(0)
  openedBoxQuantity Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([branchId, productId], map: "BranchStock_branchId_productId_key")
  @@map("branchstock")
}

model stocktransfer {
  id           String              @id @default(uuid())
  fromBranchId String?
  fromBranch   branch?             @relation("transferfrom", fields: [fromBranchId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  toBranchId   String
  toBranch     branch              @relation("transferto", fields: [toBranchId], references: [id], onUpdate: Cascade)
  staffId      String?
  staff        staff?              @relation(fields: [staffId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  status       transferstatus      @default(PENDING)
  note         String?
  items        stocktransferitem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("stocktransfer")
}

model stocktransferitem {
  id                String        @id @default(uuid())
  transferId        String
  transfer          stocktransfer @relation(fields: [transferId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  productId         String
  product           product       @relation(fields: [productId], references: [id], onUpdate: Cascade)
  quantity          Int
  fullBoxes         Int?
  openedBoxQuantity Int?
  createdAt         DateTime      @default(now())

  @@map("stocktransferitem")
}

